# Copie para ".env".

# true = os alertas só aparecem no log (docker compose logs -f monitor). Use false para enviar de verdade.
MODO_TESTE=true

# Telegram: crie um bot com o @BotFather e pegue o chat_id com o @userinfobot
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Opcional: cada alerta também é enviado como JSON para este endereço (ex.: um webhook do n8n → WhatsApp)
WEBHOOK_URL=

# Opcional: "sinal de vida" para um serviço externo (ex.: healthchecks.io).
# Se o computador do monitor desligar, é o serviço externo que avisa você.
HEARTBEAT_URL=

# Opcional: senha do painel (qualquer usuário + esta senha). Recomendado, porque o painel altera os canais.
PAINEL_SENHA=
